{
  "description": "세션 대화 기록·어댑터 경로 전달, 미션 명령·파일 쓰기 가드, 서브에이전트 허용 목록, 질문 기록 무결성 검사",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork|new|load",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session_rules.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|apply_patch|ApplyPatch|run_terminal_command|Shell|search_replace|hashline_edit|write|StrReplace|EditNotebook",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/mission_guard.py"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task|spawn_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/subagent_allow.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/question_integrity.py"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
